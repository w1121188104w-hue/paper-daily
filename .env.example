# PaperRadar local environment example.
# Copy this file to `.env` or set these variables in your service manager.
# Do not commit `.env` or real API keys.

PORT=3000

# OpenAI-compatible LLM API for summaries, chat, daily report polish, and Scholar parsing.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=700

# Optional Jina Reader API key for Google Scholar page fetching.
JINA_API_KEY=

# Scheduled refresh.
REFRESH_CRON=10 8 * * *
REFRESH_CATCHUP_CRON=0 13 * * *
REFRESH_TIMEZONE=Asia/Shanghai
REFRESH_RETRY_MINUTES=30
REFRESH_RETRY_LIMIT=3
CATCHUP_LOOKBACK_DAYS=7
CATCHUP_FAILED_LOOKBACK_DAYS=30
CATCHUP_MAX_DATES=3
CATCHUP_DELAY_MS=120000
