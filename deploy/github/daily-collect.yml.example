{
  "name": "Journal collection and optional Pages (INACTIVE TEMPLATE)",
  "on": {
    "workflow_dispatch": {},
    "schedule": [
      {
        "cron": "17 0,5 * * *"
      }
    ]
  },
  "permissions": {
    "contents": "read"
  },
  "concurrency": {
    "group": "journal-production",
    "cancel-in-progress": false
  },
  "jobs": {
    "collect": {
      "if": "vars.JOURNAL_AUTOMATION_ENABLED == 'true' && github.ref == format('refs/heads/{0}', github.event.repository.default_branch)",
      "runs-on": "ubuntu-latest",
      "timeout-minutes": 90,
      "permissions": {
        "contents": "write"
      },
      "outputs": {
        "collection_outcome": "${{ steps.collect.outcome }}",
        "enrichment_outcome": "${{ steps.enrich.outcome }}",
        "translation_attention": "${{ steps.translate.outputs.attention }}"
      },
      "steps": [
        {
          "name": "Checkout default-branch source and formal history",
          "uses": "actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803",
          "with": {
            "ref": "${{ github.event.repository.default_branch }}",
            "persist-credentials": true
          }
        },
        {
          "name": "Set up Node.js 24",
          "uses": "actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38",
          "with": {
            "node-version": "24",
            "package-manager-cache": false
          }
        },
        {
          "name": "Install locked dependencies without lifecycle scripts",
          "run": "npm ci --ignore-scripts"
        },
        {
          "name": "Run all offline tests",
          "run": "npm test"
        },
        {
          "name": "Validate existing formal library before any source requests",
          "run": "node scripts/journal-library.js --validate"
        },
        {
          "name": "Collect both sources for all 19 journals; no AI",
          "id": "collect",
          "continue-on-error": true,
          "run": "node scripts/journal-library.js --collect --save --all --lookback-days 60 --only-if-needed"
        },
        {
          "name": "Check official lists for 60 days and fill only real missing abstracts",
          "id": "enrich",
          "if": "vars.JOURNAL_ENRICHMENT_ENABLED == 'true'",
          "continue-on-error": true,
          "env": { "SEMANTIC_SCHOLAR_API_KEY": "${{ secrets.SEMANTIC_SCHOLAR_API_KEY }}" },
          "run": "node scripts/enrich-library.js --run --save --all --official --abstracts --lookback-days 60 --max-abstracts 100 --only-if-needed --github-output"
        },
        {
          "name": "Validate saved results even after source failures",
          "run": "node scripts/journal-library.js --validate"
        },
        {
          "name": "Stage only the closed, validated formal history",
          "run": "node scripts/journal-git-files.js --stage"
        },
        {
          "name": "Commit and push data without force or unrelated files",
          "env": {
            "DATA_BRANCH": "${{ github.event.repository.default_branch }}"
          },
          "run": "git config user.name 'github-actions[bot]'\ngit config user.email '41898282+github-actions[bot]@users.noreply.github.com'\nif ! git diff --cached --quiet; then\n  git commit -m 'data: save journal collection'\n  git push origin \"HEAD:refs/heads/$DATA_BRANCH\"\nfi"
        },
        {
          "name": "Translate pending research papers automatically after collection",
          "id": "translate",
          "if": "vars.JOURNAL_TRANSLATION_ENABLED == 'true'",
          "env": {
            "DEEPSEEK_API_KEY": "${{ secrets.DEEPSEEK_API_KEY }}",
            "JOURNAL_TRANSLATION_ENABLED": "${{ vars.JOURNAL_TRANSLATION_ENABLED }}",
            "DATA_BRANCH": "${{ github.event.repository.default_branch }}"
          },
          "run": "node scripts/translate-library.js --run --mode daily --github-output"
        },
        {
          "name": "Validate formal library after automatic translation",
          "run": "node scripts/journal-library.js --validate"
        },
        {
          "name": "Build validated static site; old Pages remains if this fails",
          "id": "build",
          "run": "node scripts/build-journal-site.js --github-output"
        },
        {
          "name": "Check existing Pages configuration",
          "if": "vars.JOURNAL_PAGES_ENABLED == 'true'",
          "uses": "actions/configure-pages@983d7736d9b0ae728b81ab479565c72886d7745b"
        },
        {
          "name": "Upload website ONLY, never the full data directory",
          "if": "vars.JOURNAL_PAGES_ENABLED == 'true'",
          "uses": "actions/upload-pages-artifact@fc324d3547104276b827a68afc52ff2a11cc49c9",
          "with": {
            "path": "${{ steps.build.outputs.directory }}",
            "include-hidden-files": true
          }
        }
      ]
    },
    "deploy": {
      "if": "vars.JOURNAL_PAGES_ENABLED == 'true'",
      "needs": "collect",
      "runs-on": "ubuntu-latest",
      "timeout-minutes": 15,
      "permissions": {
        "pages": "write",
        "id-token": "write"
      },
      "environment": {
        "name": "github-pages",
        "url": "${{ steps.deployment.outputs.page_url }}"
      },
      "steps": [
        {
          "name": "Deploy the already validated static artifact",
          "id": "deployment",
          "uses": "actions/deploy-pages@d6db90164ac5ed86f2b6aed7e0febac5b3c0c03e"
        }
      ]
    },
    "report_translation_attention": {
      "if": "always() && needs.collect.outputs.translation_attention == 'true'",
      "needs": ["collect", "deploy"],
      "runs-on": "ubuntu-latest",
      "timeout-minutes": 5,
      "permissions": {},
      "steps": [{ "name": "Report held translations after preserving accepted data", "run": "echo 'Some translation tasks are held or paused. Accepted translations were preserved; do not blindly retry paid requests.'\nexit 1" }]
    },
    "report_source_failure": {
      "if": "always() && (needs.collect.outputs.collection_outcome == 'failure' || needs.collect.outputs.enrichment_outcome == 'failure')",
      "needs": [
        "collect",
        "deploy"
      ],
      "runs-on": "ubuntu-latest",
      "timeout-minutes": 5,
      "permissions": {},
      "steps": [
        {
          "name": "Report incomplete collection after preserving usable data",
          "run": "echo 'Collection had a failure. Any valid saved data was retained; inspect collection logs.'\nexit 1"
        }
      ]
    }
  }
}
