{
  "name": "paper-daily",
  "version": "1.0.0",
  "description": "Journal discovery, browser source verification, translation and publication",
  "type": "module",
  "scripts": {
    "dev": "node --watch scripts/journal-preview.js",
    "start": "node scripts/journal-preview.js",
    "test": "node --test",
    "journals:check": "node scripts/journals.js",
    "journals:collect": "node scripts/discover-collection.js --run --save-sources",
    "journals:status": "node scripts/journal-library.js --status",
    "journals:save": "node scripts/journal-library.js --collect --save",
    "translations:queue": "node scripts/translations.js --queue",
    "translations:export": "node scripts/translations.js --export",
    "journals:preview": "node scripts/journal-preview.js",
    "journals:preview:check": "node scripts/journal-preview.js --check",
    "journals:build": "node scripts/build-journal-site.js"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "fast-xml-parser": "^4.5.0",
    "node-cron": "^3.0.3",
    "pdf-parse": "^1.1.1"
  }
}
